import VersoManual

namespace SFLMeta

/--
Renders a directive's child blocks as TeX, with a paragraph break after each. This works around a
Verso bug where consecutive paragraphs can be run together.

A directive's contents form a sequence of blocks just as a part's do, so each one ends its own
paragraph.
-/
def texBlocks [Monad m] (goB : β → m Verso.Output.TeX) (contents : Array β) :
    m Verso.Output.TeX := do
  return .seq (← contents.mapM fun b => return .seq #[← goB b, .paragraphBreak])
